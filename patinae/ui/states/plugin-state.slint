export struct PluginOption {
    label: string,
    value: string,
}

export struct PluginButtonItem {
    id: string,
    label: string,
    icon: string,
    primary: bool,
    enabled: bool,
}

export struct PluginHighlightRun {
    text: string,
    style: string,
    start-col: int,
}

export struct PluginHighlightLine {
    runs: [PluginHighlightRun],
}

export struct PluginToolbarItem {
    id: string,
    title: string,
    icon: string,
    placement: string,
    visible: bool,
    active: bool,
}

// Terminal control inside a leaf-level row/column (the 4th nesting level).
// Lets a zone column hold horizontal field rows (label-above pairs, a title +
// action button, etc.) instead of one control per line.
export struct PluginSubLeaf {
    id: string,
    kind: string,
    label: string,
    text: string,
    value-text: string,
    bool-value: bool,
    num-value: float,
    min: float,
    max: float,
    step: float,
    primary: bool,
    read-only: bool,
    rows: float,
    grow: float,
    gap: float,
    height: float,
    highlight-lines: [PluginHighlightLine],
    options: [PluginOption],
    buttons: [PluginButtonItem],
}

export struct PluginControlLeaf {
    id: string,
    kind: string,
    label: string,
    text: string,
    value-text: string,
    bool-value: bool,
    num-value: float,
    min: float,
    max: float,
    step: float,
    primary: bool,
    open: bool,
    read-only: bool,
    rows: float,
    grow: float,
    gap: float,
    height: float,
    highlight-lines: [PluginHighlightLine],
    options: [PluginOption],
    buttons: [PluginButtonItem],
    sub-children: [PluginSubLeaf],
    image-value: image,
    image-width: float,
    image-height: float,
}

export struct PluginControlNode {
    id: string,
    kind: string,
    label: string,
    text: string,
    value-text: string,
    bool-value: bool,
    num-value: float,
    min: float,
    max: float,
    step: float,
    primary: bool,
    open: bool,
    read-only: bool,
    rows: float,
    grow: float,
    gap: float,
    height: float,
    highlight-lines: [PluginHighlightLine],
    options: [PluginOption],
    buttons: [PluginButtonItem],
    leaf-children: [PluginControlLeaf],
    image-value: image,
    image-width: float,
    image-height: float,
}

export struct PluginPanelTab {
    id: string,
    title: string,
    active: bool,
}

// ── Conversational controls ───────────────────────────────────────────
// One span of a message body. `kind` is "code" or "prose"; code carries the
// fence's info string as `language` and gets its own monospace surface.
export struct PluginMessageBlock {
    kind: string,
    language: string,
    text: string,
}

// One entry in a transcript. `id` is stable across snapshots so the bridge can
// reuse rows instead of rebuilding the whole list on every streamed token.
export struct PluginMessage {
    id: string,
    // "user" | "assistant" | "tool" | "error"
    role: string,
    author: string,
    // "" | "running" | "ok" | "denied" | "failed" — tool rows only.
    status: string,
    detail: string,
    blocks: [PluginMessageBlock],
}

export struct PluginControl {
    id: string,
    kind: string,
    label: string,
    text: string,
    value-text: string,
    bool-value: bool,
    num-value: float,
    min: float,
    max: float,
    step: float,
    primary: bool,
    open: bool,
    read-only: bool,
    rows: float,
    grow: float,
    gap: float,
    height: float,
    highlight-lines: [PluginHighlightLine],
    options: [PluginOption],
    buttons: [PluginButtonItem],
    children: [PluginControlNode],
    image-value: image,
    image-width: float,
    image-height: float,
    // Absorbs the panel's leftover height rather than declaring a fixed one.
    stretch: float,
    // Transcript rows, and whether to show the working indicator at the tail.
    messages: [PluginMessage],
    busy: bool,
    // Composer keyboard hint / notice tone ("info" | "warn" | "danger").
    hint: string,
    tone: string,
}

export global PluginState {
    in-out property <[PluginToolbarItem]> toolbar-items;
    in-out property <[PluginPanelTab]> right-tabs;
    in-out property <[PluginPanelTab]> bottom-tabs;
    in-out property <[PluginControl]> active-right-controls;
    in-out property <[PluginControl]> active-bottom-controls;
    in-out property <string> active-right-panel-id;
    in-out property <string> active-bottom-panel-id;
    in-out property <string> active-right-title;
    in-out property <string> active-bottom-title;
    in-out property <bool> right-visible: false;
    in-out property <bool> bottom-visible: false;
    // Whether the active panel lays out to full height instead of scrolling as
    // a whole. Computed in Rust — folding over a model inside Slint is awkward,
    // and the snapshot already knows the answer.
    in-out property <bool> right-fills: false;
    in-out property <bool> bottom-fills: false;

    callback toggle-panel(string);
    callback activate-panel(string);
    callback deactivate-placement(string);
    callback control-event(string, string, string, string, float, bool);
}
