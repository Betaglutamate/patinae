component PluginTextAreaPane inherits Rectangle {
    in property <string> panel-id;
    in property <string> control-id;
    in property <string> label;
    in property <string> value-text;
    in property <string> placeholder;
    in property <bool> read-only;
    in property <[PluginHighlightLine]> highlight-lines;

    VerticalLayout {
        spacing: 4px;

        Text {
            visible: root.label != "";
            height: root.label == "" ? 0px : 14px;
            text: root.label;
            color: Theme.text-dim;
            font-size: Tokens.font-sm;
        }

        HighlightedTextArea {
            vertical-stretch: 1;
            min-height: 48px;
            identity: root.control-id;
            value-text: root.value-text;
            placeholder: root.placeholder;
            read-only: root.read-only;
            highlight-lines: root.highlight-lines;
            font-family: "JetBrains Mono";
            font-size: Tokens.font-md;

            edited(text) => {
                PluginState.control-event(root.panel-id, root.control-id, "text-area-edit", text, 0, false);
            }

            committed(text) => {
                PluginState.control-event(root.panel-id, root.control-id, "text-commit", text, 0, false);
            }
        }
    }
}

component PluginLeafToggle inherits Rectangle {
    in property <PluginControlLeaf> control;
    in property <string> panel-id;

    height: 28px;

    HorizontalLayout {
        spacing: Tokens.space-sm;

        Rectangle {
            width: 30px;
            height: 100%;
            background: transparent;

            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 16px;
                border-radius: 8px;
                border-width: Tokens.hairline;
                border-color: root.control.bool-value ? Theme.cyan.with-alpha(0.60) : Theme.line-strong;
                background: root.control.bool-value ? Theme.cyan.with-alpha(0.28) : Theme.bg-inset;

                Rectangle {
                    x: root.control.bool-value ? parent.width - self.width - 2px : 2px;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.control.bool-value ? Theme.cyan : Theme.text-muted;
                    animate x { duration: Tokens.motion-micro; easing: ease-out; }
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            height: 100%;
            text: root.control.label;
            color: Theme.text-dim;
            font-size: Tokens.font-md;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PluginState.control-event(
                root.panel-id,
                root.control.id,
                "toggle",
                "",
                0,
                !root.control.bool-value
            );
        }
    }
}

// Two roles share the "button" leaf, distinguished by id:
//  - "run": a prominent filled action button (centered, bordered).
//  - everything else: a compact, flat tool-rail row; `primary` marks the
//    active tool with a cyan fill + left accent bar. Keeps the rail compact.
component PluginLeafButton inherits Rectangle {
    in property <PluginControlLeaf> control;
    in property <string> panel-id;
    property <bool> action: root.control.id == "run";

    height: 100%;
    border-radius: Tokens.radius-sm;
    background: root.action
        ? (touch.has-hover ? Theme.cyan.brighter(0.15) : Theme.cyan)
        : root.control.primary ? Theme.cyan.with-alpha(0.14)
        : touch.has-hover ? Theme.bg-inset.with-alpha(0.6) : transparent;

    if root.control.primary && !root.action: Rectangle {
        x: 0;
        width: 2px;
        height: parent.height - 6px;
        y: 3px;
        background: Theme.cyan;
    }

    Text {
        x: root.action ? 0px : 10px;
        width: root.action ? parent.width : parent.width - 20px;
        height: 100%;
        text: root.control.label;
        color: root.action ? Theme.bg : (root.control.primary ? Theme.cyan : Theme.text-dim);
        font-size: root.action ? Tokens.font-md : Tokens.font-sm;
        font-weight: root.action || root.control.primary ? 500 : 400;
        horizontal-alignment: root.action ? center : left;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PluginState.control-event(root.panel-id, root.control.id, "click", "", 0, false);
        }
    }
}

component PluginLeafOptionChip inherits Rectangle {
    in property <PluginOption> option;
    in property <PluginControlLeaf> control;
    in property <string> panel-id;
    property <bool> selected: root.option.value == root.control.value-text;

    width: max(42px, label.preferred-width + 16px);
    height: 28px;
    border-radius: Tokens.radius-sm;
    background: selected ? Theme.cyan.with-alpha(0.14) : touch.has-hover ? Theme.bg-inset : transparent;
    border-width: Tokens.hairline;
    border-color: selected ? Theme.cyan.with-alpha(0.55) : Theme.line;

    label := Text {
        text: root.option.label;
        color: root.selected ? Theme.cyan : Theme.text-muted;
        font-size: Tokens.font-sm;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PluginState.control-event(root.panel-id, root.control.id, "select", root.option.value, 0, false);
        }
    }
}

component PluginLeafSelect inherits VerticalLayout {
    in property <PluginControlLeaf> control;
    in property <string> panel-id;

    spacing: 4px;
    alignment: start;

    Text {
        text: root.control.label;
        color: Theme.text-dim;
        font-size: Tokens.font-sm;
        vertical-stretch: 0;
    }

    HorizontalLayout {
        spacing: Tokens.space-xs;
        vertical-stretch: 0;
        for option in root.control.options: PluginLeafOptionChip {
            option: option;
            control: root.control;
            panel-id: root.panel-id;
        }
    }
}

component PluginLeafTextArea inherits Rectangle {
    in property <PluginControlLeaf> control;
    in property <string> panel-id;

    PluginTextAreaPane {
        width: 100%;
        height: 100%;
        panel-id: root.panel-id;
        control-id: root.control.id;
        label: root.control.label;
        value-text: root.control.value-text;
        placeholder: root.control.text;
        read-only: root.control.read-only;
        highlight-lines: root.control.highlight-lines;
    }
}

component PluginSubTextInput inherits Rectangle {
    in property <PluginSubLeaf> control;
    in property <string> panel-id;

    VerticalLayout {
        spacing: 3px;
        alignment: start;

        Text {
            visible: root.control.label != "";
            height: root.control.label == "" ? 0px : 14px;
            text: root.control.label;
            color: Theme.text-dim;
            font-size: Tokens.font-sm;
        }

        Rectangle {
            height: 28px;
            border-radius: Tokens.radius-sm;
            background: Theme.bg-inset.with-alpha(0.70);
            border-width: Tokens.hairline;
            border-color: input.has-focus ? Theme.cyan.with-alpha(0.65) : Theme.line;

            input := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.control.value-text;
                single-line: true;
                color: Theme.text-dim;
                font-size: Tokens.font-md;
                vertical-alignment: center;
                selection-background-color: Theme.cyan.with-alpha(0.3);
                selection-foreground-color: Theme.text;

                edited => {
                    PluginState.control-event(root.panel-id, root.control.id, "text-edit", self.text, 0, false);
                }
                accepted => {
                    PluginState.control-event(root.panel-id, root.control.id, "text-commit", self.text, 0, false);
                }
            }
        }
    }
}

component PluginSubOptionChip inherits Rectangle {
    in property <PluginOption> option;
    in property <PluginSubLeaf> control;
